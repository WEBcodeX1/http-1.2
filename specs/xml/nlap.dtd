<?xml version="1.0" encoding="UTF-8"?>

<!--
    NLAP (Next Level Application Protocol) DTD
    Version: 0.1

    Sub-protocols covered:
      - NLAMP  (Next Level Application Metadata Protocol)
      - NLAFP  (Next Level Application File Protocol)
      - NLASP  (Next Level Application Session Protocol)
      - NLAPP  (Next Level Application Proxy Protocol)
      - NLAPS  (Next Level Application Protocol Secure Extension)

    NOTE: result codes / enum definitions for <Code>, <Subtype>,
    <Compression>, <Mime-Type>, etc. are work in progress and will
    be refined manually.
-->

<!-- ============================================================
     Root element
     ============================================================ -->

<!ELEMENT nlap (Request | Response)>

<!-- ============================================================
     Request
     ============================================================ -->

<!ELEMENT Request (UUID, Protocol, Version, Subtype, Header, Security?, Payload?)>

<!-- ============================================================
     Response
     ============================================================ -->

<!ELEMENT Response (UUID, Protocol, Version, Subtype, Header, Security?, Payload?, Status?)>

<!-- ============================================================
     Common fields shared by request and response
     ============================================================ -->

<!-- Universally unique identifier (RFC 4122) for request/response correlation -->
<!ELEMENT UUID (#PCDATA)>

<!-- Always "NLAP" -->
<!ELEMENT Protocol (#PCDATA)>

<!-- Protocol version, e.g. "0.1" -->
<!ELEMENT Version (#PCDATA)>

<!-- Sub-protocol selector: NLAMP | NLAFP | NLASP | NLAPP | NLAPS -->
<!ELEMENT Subtype (#PCDATA)>

<!-- ============================================================
     Header
     All child elements are optional to support both request and
     response headers across all sub-protocols.
     ============================================================ -->

<!ELEMENT Header (
    Host?,
    URL?,
    User-Agent?,
    user?,
    Connection-Close?,
    Mime-Type?,
    Encoding?,
    Byte-Size?,
    Byte-Size-Full?,
    Byte-Size-Part?,
    Compression?,
    File-UUID?,
    File-Part-Sum?,
    File-Part?
)>

<!-- Request header fields -->

<!-- Virtual host name, e.g. "testapp1.local" -->
<!ELEMENT Host (#PCDATA)>

<!-- Request path / resource URL, e.g. "/testpath/index.html" -->
<!ELEMENT URL (#PCDATA)>

<!-- Client identifier, e.g. "Falcon-Browser" -->
<!ELEMENT User-Agent (#PCDATA)>

<!-- Authenticated user identity (NLAPS), e.g. "user1@domain.com" -->
<!ELEMENT user (#PCDATA)>

<!-- Response header fields -->

<!-- Signal connection teardown after response: 0 | 1 -->
<!ELEMENT Connection-Close (#PCDATA)>

<!-- MIME type of the payload, e.g. "text/html", "application/json", "image/png" -->
<!ELEMENT Mime-Type (#PCDATA)>

<!-- Character / transfer encoding, e.g. "UTF-8", "binary" -->
<!ELEMENT Encoding (#PCDATA)>

<!-- Total byte size of a single-part file payload -->
<!ELEMENT Byte-Size (#PCDATA)>

<!-- Total byte size of the complete file (multi-part transfer) -->
<!ELEMENT Byte-Size-Full (#PCDATA)>

<!-- Byte size of this individual part (multi-part transfer) -->
<!ELEMENT Byte-Size-Part (#PCDATA)>

<!-- Compression algorithm applied to the payload: none | gzip | bzip2 | ... -->
<!ELEMENT Compression (#PCDATA)>

<!-- UUID identifying the file across all parts of a multi-part transfer -->
<!ELEMENT File-UUID (#PCDATA)>

<!-- Total number of parts in a multi-part transfer -->
<!ELEMENT File-Part-Sum (#PCDATA)>

<!-- Index of this part within the multi-part transfer (1-based) -->
<!ELEMENT File-Part (#PCDATA)>

<!-- ============================================================
     Security block (NLAPS)
     ============================================================ -->

<!ELEMENT Security (Encryption, Signature)>

<!-- Encryption flag: 0 = disabled, 1 = enabled -->
<!ELEMENT Encryption (#PCDATA)>

<!-- Base64-encoded cryptographic signature of the payload -->
<!ELEMENT Signature (#PCDATA)>

<!-- ============================================================
     Payload
     ANY is used to accommodate plain text, JSON, inline HTML/XML,
     and binary (base64-encoded) content depending on sub-protocol.
     ============================================================ -->

<!ELEMENT Payload ANY>

<!-- ============================================================
     Status block (response only)
     ============================================================ -->

<!ELEMENT Status (Code, Description?, Exception?)>

<!-- Numeric result code; 0 = success; non-zero = error (WIP: enum TBD) -->
<!ELEMENT Code (#PCDATA)>

<!-- Human-readable description of the result or error condition -->
<!ELEMENT Description (#PCDATA)>

<!-- Exception detail string, e.g. a Python traceback line -->
<!ELEMENT Exception (#PCDATA)>
